# Shared defaults for local development
APP_NAME=
SERVER_PORT=
DB_URL=jdbc:postgresql://localhost:5432/smartbank_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Schema names
ACCOUNT_SCHEMA=account_schema
AUTH_SCHEMA=auth_schema
CUSTOMER_SCHEMA=customer_schema
TRANSACTION_SCHEMA=transaction_schema

# External service URLs
CUSTOMER_SERVICE_BASE_URL=http://localhost:8081
AUTH_SERVICE_URL=http://localhost:8083
ACCOUNT_SERVICE_URL=http://localhost:8082
TRANSACTION_SERVICE_URL=http://localhost:8084
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security
JWT_SECRET=replace-with-a-strong-base64-secret
JWT_EXPIRATION_MS=900000
JWT_ISSUER=smartbank-auth-service

# Monitoring
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
MANAGEMENT_HEALTH_DETAILS=always
METRICS_HTTP_LATENCY_HISTOGRAM=true
GATEWAY_LOG_LEVEL=INFO

# Resilience / Kafka / Outbox tuning
CB_REGISTER_HEALTH_INDICATOR=true
CB_SLIDING_WINDOW_TYPE=COUNT_BASED
CB_SLIDING_WINDOW_SIZE=5
CB_MIN_CALLS=3
CB_FAILURE_RATE_THRESHOLD=50
CB_WAIT_OPEN_STATE=10s
CB_HALF_OPEN_CALLS=2
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_DURATION=500ms
RATE_LIMIT_PER_PERIOD=100
RATE_LIMIT_REFRESH_PERIOD=10s
RATE_LIMIT_TIMEOUT=0
BULKHEAD_MAX_CONCURRENT_CALLS=50
BULKHEAD_MAX_WAIT_DURATION=0
TIMEOUT_DURATION=2s
TIMEOUT_CANCEL_RUNNING=true
KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_PRODUCER_VALUE_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
KAFKA_PRODUCER_ADD_TYPE_HEADERS=false
KAFKA_CONSUMER_GROUP_ID=transaction-audit-consumer
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
KAFKA_CONSUMER_VALUE_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
OUTBOX_FIXED_DELAY_MS=5000
OUTBOX_MAX_RETRIES=3
